# Override the sim server URL (e.g. WSS in production or a non-standard dev topology).
# Do NOT set this for local LAN dev — the app derives host AND protocol from the page origin.
# VITE_SIM_URL=wss://sim.example.com
# Change only the sim port, keeping host/protocol derivation intact:
# VITE_SIM_PORT=2567
VITE_MOBILE_PORT=5174
# VITE_MOBILE_URL=http://192.168.x.x:5174  # only used if the /local-ip probe fails
