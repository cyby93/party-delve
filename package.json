{
  "name": "party-delve",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently --names sim,host,mobile --prefix-colors cyan,green,yellow \"pnpm --filter simulation-server start\" \"pnpm --filter host-client dev\" \"pnpm --filter mobile-controller dev\"",
    "install:apps": "pnpm install",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0"
  }
}
